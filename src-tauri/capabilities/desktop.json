{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop",
	"description": "Desktop-only capabilities: in-app updater, process relaunch, and window state",
	"windows": ["main", "agentero-*", "settings"],
	"platforms": ["macOS", "windows", "linux"],
	"permissions": [
		"updater:default",
		"process:default",
		"window-state:default"
	]
}
