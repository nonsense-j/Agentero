{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dovero",
  "mainBinaryName": "Dovero",
  "version": "0.1.0",
  "identifier": "io.github.nonsense-j.dovero",
  "build": {
    "beforeDevCommand": "pnpm pdfium:stage && pnpm adapters:stage && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm pdfium:stage && pnpm adapters:stage && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dovero",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFM0JFMzE2N0JGNUZDOUIKUldTYi9QVjdGdU03UHZ2Z0RDYTZEUWdPTWdpb1JYK0trWWVlbG1PbjZCUGR4TTZvakhtditzc1MK",
      "endpoints": [
        "https://github.com/nonsense-j/Dovero/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["dovero"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "resources": [
      "pdfium/*",
      "adapters/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
